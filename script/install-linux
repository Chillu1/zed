#!/usr/bin/env bash

set -euxo pipefail

fast_flag=""
if [[ "${1:-}" == "--fast" ]]; then
  fast_flag="--fast"
elif [[ $# -gt 0 ]]; then
  echo "
  Usage: ${0##*/} [--fast]
  Builds and installs zed onto your system into ~/.local, making it available as ~/.local/bin/zed.

  --fast  Use release-fast profile (lto=false, incremental). Faster iteration; not for CI releases.

  Before running this you should ensure you have all the build dependencies installed with \`./script/linux\`.
  "
  exit 1
fi

export ZED_CHANNEL=$(<crates/zed/RELEASE_CHANNEL)
export ZED_UPDATE_EXPLANATION="You need to fetch and rebuild zed in $(pwd)"
script/bundle-linux $fast_flag

arch="$(uname -m)"
commit=$(git rev-parse HEAD | cut -c 1-7)
archive="zed-linux-${arch}.tar.gz"
build_subdir="release"
[[ -n "$fast_flag" ]] && build_subdir="release-fast"
export ZED_BUNDLE_PATH="${CARGO_TARGET_DIR:-target}/${build_subdir}/${archive}"
script/install.sh
